# Derived from the file's own location rather than the configure-time install
# prefix, so the release archives stay usable wherever they are extracted and
# `cmake --install --prefix` is honoured.
prefix=${pcfiledir}/@BLINK_PC_PREFIX_FROM_PCFILEDIR@
exec_prefix=${prefix}
libdir=@BLINK_PC_LIBDIR@
includedir=@BLINK_PC_INCLUDEDIR@

Name: blink
Description: Keyboard LED and LCD control library for SK80 and RK84 RGB mechanical keyboards
URL: https://github.com/TheNotary/keyboard_driver_sk80
Version: @PROJECT_VERSION@

# The public header is <blink/blink.h>, so only the parent directory is needed.
Cflags: -I${includedir}
Libs: -L${libdir} -lblink

# Only the static archive exposes these. The shared library links hidapi
# privately and hides it with --exclude-libs, so a dynamic consumer must not
# try to resolve it.
Requires.private: @BLINK_PC_REQUIRES_PRIVATE@
Libs.private: @BLINK_PC_LIBS_PRIVATE@
