@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# blink::blink_static propagates hidapi to whoever links it, so the dependency
# has to be re-discovered here. The provider is baked in at configure time so
# that a package built against vcpkg's hidapi does not silently fall back to a
# distro one (or vice versa).
if(NOT WIN32)
    if("@BLINK_HIDAPI_PROVIDER@" STREQUAL "config")
        find_dependency(hidapi CONFIG)
    else()
        find_dependency(PkgConfig)
        pkg_check_modules(HIDAPI REQUIRED IMPORTED_TARGET hidapi-libusb)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/blinkTargets.cmake")

check_required_components(blink)
