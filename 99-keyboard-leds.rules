# XVX S-K80 Keyboard LED Control - udev rules
# Install: sudo cp 99-keyboard-leds.rules /etc/udev/rules.d/
# Reload: sudo udevadm control --reload-rules && sudo udevadm trigger

# XVX S-K80 (VID: 05ac, PID: 024f)
KERNEL=="hidraw*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="024f", MODE="0660", GROUP="plugdev"

# Royal Kludge RK84 (VID: 258a, PID: 00c0)
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="00c0", MODE="0660", GROUP="plugdev"
